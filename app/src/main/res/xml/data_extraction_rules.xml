<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores should leave the device through a backup or a device-to-device
  transfer: the outbox holds photographs of a customer's building, and the secure preferences
  hold a bearer token. The app is enrolled per handset, so there is nothing worth restoring.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
