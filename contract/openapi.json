  "components": {
    "schemas": {
      "Body_submit_capture_v1_captures_post": {
        "properties": {
          "metadata": {
            "type": "string",
            "maxLength": 65536,
            "title": "Metadata"
          },
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image"
          }
        },
        "type": "object",
        "required": [
          "metadata",
          "image"
        ],
        "title": "Body_submit_capture_v1_captures_post"
      },
      "Decision": {
        "properties": {
          "ticket_id": {
            "type": "integer",
            "maximum": 999999999.0,
            "minimum": 1.0,
            "title": "Ticket Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "approve_intervention",
              "reject_intervention",
              "approve_completion",
              "request_rework"
            ],
            "title": "Action"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "approval_id": {
            "type": "string",
            "format": "uuid",
            "title": "Approval Id"
          },
          "expected_updated_at": {
            "type": "string",
            "maxLength": 64,
            "title": "Expected Updated At"
          },
          "request_id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ticket_id",
          "action",
          "approval_id",
          "expected_updated_at",
          "request_id"
        ],
        "title": "Decision",
        "description": "The FM's decision on one ticket, as the dashboard card offered it.\n\napproval_id and expected_updated_at come from the card: the workflows refuse the decision if\nthe ticket moved on meanwhile, so nobody decides a ticket they are no longer looking at.\nrequest_id is the phone's own id for this tap, which makes a repeat harmless."
      },
      "Device": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ANDROID",
              "IOS"
            ],
            "title": "Platform"
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "os_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Os Version"
          },
          "app_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "App Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "platform"
        ],
        "title": "Device"
      },
      "GoogleLogin": {
        "properties": {
          "id_token": {
            "type": "string",
            "maxLength": 4096,
            "title": "Id Token"
          },
          "device": {
            "$ref": "#/components/schemas/Device"
          }
        },
        "additionalProperties": false,
