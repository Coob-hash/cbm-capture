<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theme; this is only what the window shows before the first
         frame. Keeping it Material3.DayNight avoids a white flash on a camera-first screen. -->
    <style name="Theme.CbmCapture" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
